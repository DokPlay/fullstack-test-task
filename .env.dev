# DEVELOPMENT DEMO CONFIGURATION.
# This file is committed only because it contains safe demo values
# required for one-command local startup after clone.
#
# If you replace these demo values with real passwords, tokens,
# database URLs, or server keys, do not commit or push this file.
# Before pushing, make sure .env.dev is ignored by Git, run
# `git rm --cached .env.dev` if Git already tracks it, and confirm
# with `git status` that .env.dev is not staged for commit.
#
# Real env values are access keys to your application and infrastructure.
# Do not publish them to GitHub or any shared/cloud repository.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=test
POSTGRES_HOST=backend-db
POSTGRES_PORT=5432
PGPORT=5432
PGSSLMODE=disable
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# Celery / Redis
REDIS_URL=redis://backend-redis:6379/0
CELERY_BROKER_URL=redis://backend-redis:6379/0

# Public frontend origins allowed by backend CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload safety limits. Keep MAX_UPLOAD_SIZE_BYTES >= MAX_FILE_SIZE_BYTES
# so oversized-but-accepted files can still be marked suspicious by the scanner.
MAX_FILE_SIZE_BYTES=10485760
MAX_UPLOAD_SIZE_BYTES=52428800

# Processing watchdog
PROCESSING_TIMEOUT_SECONDS=120
PROCESSING_RECOVERY_INTERVAL_SECONDS=30
MAX_PROCESSING_ATTEMPTS=3

# Realtime dashboard events
DASHBOARD_EVENTS_CHANNEL=dashboard-events
DASHBOARD_EVENTS_HEARTBEAT_SECONDS=15
DASHBOARD_EVENTS_RETRY_TIMEOUT_MS=3000
